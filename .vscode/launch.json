{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Windows)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "toolArgs": ["-d", "windows"]
    },
    {
      "name": "Flutter (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "toolArgs": ["-d", "chrome"]
    },
    {
      "name": "Flutter (Android)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "toolArgs": ["-d", "android"]
    },
    {
      "name": "Flutter (iOS 模拟器)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart",
      "toolArgs": ["-d", "caldav-free"],
      "preLaunchTask": "ios: boot simulator"
    },
    {
      "name": "Flutter (iOS 真机 / 选择设备)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart"
    },
    {
      "name": "Flutter (macOS)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart",
      "toolArgs": ["-d", "macos"]
    },
    {
      "name": "Flutter (macOS, Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["-d", "macos"]
    }
  ]
}
