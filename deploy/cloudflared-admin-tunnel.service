[Unit]
Description=Cloudflare Quick Tunnel for caldav-free admin UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:5234 --no-autoupdate --protocol http2
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
